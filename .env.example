# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
# 호스트 포트가 다른 프로그램과 겹칠 때만 바꾼다. 컨테이너 안 포트는 고정이다.
MQTT_PORT=1883
PLAYER_PORT=8080
PLAYBACK_DECIDER_PORT=8001

# playback-decider 판정 기준. 바꾼 뒤 docker compose up -d playback-decider로 다시 띄운다.
# 얼굴이 PLAY_AFTER_MS 동안 이어지면 재생, PAUSE_AFTER_MS 동안 없으면 정지. score가 MIN_SCORE보다 낮으면 얼굴 없음으로 본다.
PLAY_AFTER_MS=500
PAUSE_AFTER_MS=1500
MIN_SCORE=0.6
