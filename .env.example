# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
# 호스트 포트가 다른 프로그램과 겹칠 때만 바꾼다. 컨테이너 안 포트는 고정이다.
MQTT_PORT=1883
PLAYER_PORT=8080
PLAYBACK_DECIDER_PORT=8001
RECORDER_PORT=8002

# 로그 (docs/logging-design.txt). dev: 콘솔·logs/zt.log에 DEBUG까지, prod: INFO 이상. 시각은 LOG_TZ 시간대로 찍는다.
LOG_ENV=prod
LOG_TZ=Asia/Seoul

# playback-decider 판정 기준. 바꾼 뒤 docker compose up -d playback-decider로 다시 띄운다.
# 얼굴이 PLAY_AFTER_MS 동안 이어지면 재생, PAUSE_AFTER_MS 동안 없으면 정지. score가 MIN_SCORE보다 낮으면 얼굴 없음으로 본다.
PLAY_AFTER_MS=500
PAUSE_AFTER_MS=1500
# MIN_SCORE는 face-model 모델의 threshold(0.5, device/face-model/WORKLOG.md)와 같게 둔다. 그보다 높으면 face-detector가 얼굴로 보낸 것을 한 번 더 버린다.
MIN_SCORE=0.5

# 이미지 이름 (CD·데모 PC). 내 PC에서 빌드하면 :dev로 붙는다. 데모 PC는 TAG를 main의 커밋 SHA로 바꿔 pull한다.
TAG=dev
REGISTRY=ghcr.io/wkumyeungsu/real-time_face-recognition_youtube-control-system
