# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
# 고친 뒤 python gen_secrets.py로 secrets.h를 다시 만들고 업로드한다.

# ESP32-S3는 2.4GHz Wi-Fi만 된다. 5G SSID에는 붙지 않는다.
WIFI_SSID=wifi-name
WIFI_PASSWORD=wifi-password

# broker를 띄운 PC의 내부 IP (ipconfig의 Wi-Fi IPv4). localhost가 아니다.
BROKER_HOST=192.168.0.12
BROKER_PORT=1883

# 보드마다 다르게: esp32-a, esp32-b. 토픽 zt/<DEVICE_ID>/... 에 들어간다.
DEVICE_ID=esp32-a
